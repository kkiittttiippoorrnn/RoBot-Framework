# คัดลอกเป็น .env แล้วกรอกค่าจริง (.env ถูก git ignore ห้าม commit)

# PIN สำหรับ Login POS
POS_PIN=
# PIN ที่ต้องผิด ใช้ในเคส Login ไม่ผ่าน (ต้องไม่เท่ากับ POS_PIN)
POS_PIN_WRONG=

# ที่อยู่ POS ที่ test จะเปิด
POS_APP_WORKDIR=
POS_APP_EXE_NAME=

# เมนูที่ test ใช้ (ข้อความบนปุ่มเมนูของ POS)
# ขายหน้าร้าน: หมวด -> หมวดย่อย -> สินค้า 2 รายการในหมวดย่อยเดียวกัน
POS_MENU_CATEGORY=
POS_MENU_SUBCATEGORY=
POS_WALK_IN_ITEM=
POS_WALK_IN_SECOND_ITEM=
# ทานที่ร้าน: เส้นทางเมนูจนถึงสินค้า คั่นด้วย | เช่น หมวด|หมวดย่อย|สินค้า
POS_DINE_IN_MENU_PATH=

# DB ที่ POS ตัวนี้บันทึกข้อมูล (Flow 04-06 อ่านอย่างเดียว)
POS_DB_SERVER=
POS_DB_NAME=
POS_DB_UID=
POS_DB_PWD=
